# LabSync Environment Variables
# Copy this to .env.local for local development

# ─── Code Execution (Judge0) ───
# Defaults to the free public instance (https://ce.judge0.com), no key required.
# Set these only for a private or RapidAPI-hosted Judge0.
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Development only: run code with this machine's compilers instead of Judge0.
# Ignored in production builds. Never enable on a shared server.
LABSYNC_LOCAL_EXEC=false

# ─── AI Hints (Optional) ───
# Gemini API (recommended, free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional model override for drawings. Drawings use GEMINI_MODEL when empty.
GEMINI_DRAWING_MODEL=

# OpenAI API (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Without either key, the AI hint panel uses rule-based fallback hints

# ─── Supabase (teacher accounts, labs, realtime) ───
# Required for real classes. Without it LabSync runs in single-browser demo mode.
# Get your project URL and anon key from https://supabase.com/dashboard/project/_/settings/api
# Run the migration in `supabase/schema.sql` in your Supabase SQL editor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
